# Copia a .env. FastAPI carga este archivo al iniciar.
DATABASE_PATH=data/lingora.sqlite3
APP_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
# Vacío permite registros locales. Para el piloto, limita los correos:
PILOT_INVITES=
# PILOT_INVITES=persona1@example.com,persona2@example.com

AI_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
AI_DAILY_CALLS_PER_USER=20
AI_DAILY_CALLS_GLOBAL=100
AI_MAX_CALLS_PER_MINUTE=4
AI_PRICE_CONFIGURED=false
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0

# Tutor por voz: Gemini Developer API, clave AI_API_KEY solo en FastAPI.
# Activa tras verificar el modelo y las cuotas de tu proyecto.
LIVE_ENABLED=false
LIVE_MODEL=gemini-3.8-live
LIVE_MAX_SECONDS=300
LIVE_DAILY_SESSIONS_PER_USER=3
LIVE_DAILY_SESSIONS_GLOBAL=20
LIVE_CONCURRENT_GLOBAL=3

# Opcional: recuperación por correo, mediante STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Vacío mantiene SQLite; URI PostgreSQL solo en el backend.
DATABASE_URL=
DATABASE_SCHEMA=lingora
