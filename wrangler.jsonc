{
  "name": "lingora_ia",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./front/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "BACKEND_URL": "https://lingora-api.onrender.com"
  }
}
